# Vorlage für .env (nicht einchecken). Kopieren: .env.example -> .env
# Hash erzeugen mit:  node scripts/admin-passwort.js  (trägt die Zeile direkt in .env ein)

ADMIN_PASSWORD_HASH=

# Optional: Adresse des Admin-Bereichs (Standard: wunderkammer). 3 bis 40 Zeichen: a-z, 0-9, Bindestrich.
# ADMIN_PATH=wunderkammer

# Optional: Geheimnis für die Formular-Token der Meldeformulare. Ohne Angabe wird bei jedem Start ein neues erzeugt,
# dann müssen offene Formulare nach einem Neustart einmal neu geladen werden.
# FORM_SECRET=

# Nur für den Betrieb mit Docker: Benutzer, dem data/material.db gehört (Ausgabe von "id -u" und "id -g")
# APP_UID=1000
# APP_GID=1000
