{
  "name": "fawowa-material-table",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server.js",
    "dev:web": "npx vite --port 5173",
    "build": "vite build",
    "test": "node --test tests/",
    "start": "NODE_ENV=production node server.js",
    "db-zu-dateien": "node scripts/db-zu-dateien.js"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "concurrently": "^10.0.7",
    "svelte": "^5.57.3",
    "vite": "^6.0.0"
  }
}
