# Caddyfile — Reverse Proxy mit automatischem HTTPS (Let's Encrypt)
# Domain unten anpassen, dann starten mit: docker compose up -d

material.example.com {
    reverse_proxy fawowa:3456

    # Optional: Header für Sicherheit
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        -Server
    }

    # Optional: Gzip-Kompression
    encode gzip zstd
}
